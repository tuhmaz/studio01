# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:9002
NEXT_PUBLIC_BASE_URL=http://localhost:9002
APP_DOMAIN=localhost
COOKIE_DOMAIN=
ALLOWED_ORIGINS=http://localhost:9002,http://localhost:3000

# Database
