# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:9002
NEXT_PUBLIC_BASE_URL=http://localhost:9002
APP_DOMAIN=localhost
COOKIE_DOMAIN=
ALLOWED_ORIGINS=http://localhost:9002,http://localhost:3000

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hausmeister
DB_USERNAME=hausmeister_app
DB_PASSWORD=change-me

# Auth
JWT_SECRET=change-this-to-a-random-secret-of-at-least-32-characters
SESSION_COOKIE_NAME=hp_session
SESSION_EXPIRES_SECONDS=604800

# Security
HEALTHCHECK_SECRET=change-me

# AI / optional
TOGETHER_AI_API_KEY=
GOOGLE_GENAI_API_KEY=

# File storage for photos and voice notes
# local: files on this server's disk (STORAGE_LOCAL_DIR, default ./storage)
# s3:    any S3-compatible service (Hetzner Object Storage, MinIO, AWS)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# E-Mail (own mailbox via SMTP): invitations, password reset, address confirmation.
# Links in emails always point to NEXT_PUBLIC_APP_URL (set it to the public https address).
# Without SMTP_HOST, sending is off and the UI hides invitations / "Passwort vergessen".
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); 587 uses STARTTLS
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Hausmeister Pro <noreply@example.de>"

# Self-service sign-up of new companies (/register). Off by default.
ALLOW_SIGNUP=false
# Linked from the sign-up form; required reading before an account is created.
TERMS_URL=
PRIVACY_URL=

# Scheduled jobs (/api/cron/*), e.g. automatic Winterdienst planning. At least 16 characters.
CRON_SECRET=
